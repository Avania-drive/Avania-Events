# Avania Events. Copia este archivo a .env y rellénalo EN EL SERVIDOR (nunca se sube a GitHub).
PORT=3004
PUBLIC_URL=https://events.goavania.com

# Proyecto de Supabase «Avania-events»: Project Settings → Database → Connection string (URI, modo «Session pooler») y API keys
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Correo (el mismo buzón SMTP que Avania Space, para invitar a las personas del equipo)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Avania Events <no-responder@goavania.com>"
MAIL_REPLY_TO=
